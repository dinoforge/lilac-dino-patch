{
  "name": "lilacanime-desktop",
  "version": "0.5.9",
  "description": "LilacAnime inspired desktop anime library and player",
  "main": "electron/main.cjs",
  "author": "LilacAnime Desktop",
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "test:phase1-electron": "node node_modules/electron/cli.js tests/integrated-search.electron.cjs",
    "test:phase1-main": "node node_modules/electron/cli.js tests/phase1-main.electron.cjs",
    "test:phase1-source-restart": "node tests/phase1-source-restart.cjs",
    "test:phase1-subtitle-layout": "node node_modules/electron/cli.js tests/subtitle-layout.electron.cjs",
    "vendor": "node scripts/build-jassub.cjs",
    "prestart": "npm run vendor",
    "start": "electron .",
    "predev": "npm run vendor",
    "dev": "electron .",
    "predist": "npm run vendor",
    "dist": "electron-builder --win nsis",
    "predist:mac": "npm run vendor",
    "dist:mac": "electron-builder --mac dmg",
    "prepack": "npm run vendor",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "jassub": "^2.5.16"
  },
  "build": {
    "appId": "com.lilac.anime.desktop",
    "productName": "LilacAnime",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "licenses/Liberation-Fonts-2.00.5-OFL-1.1.txt",
        "to": "licenses/Liberation-Fonts-2.00.5-OFL-1.1.txt"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "LilacAnime",
      "target": "nsis",
      "artifactName": "LilacAnime-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "target": "dmg",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "LilacAnime-mac-${arch}.${ext}"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "cheerio": "^1.1.2",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.3"
  }
}
